# Copy this file to .env for local use if desired.
# Do not commit real API keys.

# OpenAI-compatible providers
OPENAI_API_KEY=replace_with_your_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Gemini OpenAI-compatible API
GEMINI_API_KEY=replace_with_your_gemini_key
SAFEMAP_MODEL=gemini-3.5-flash-lite
SAFEMAP_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Local Ollama OpenAI-compatible API
OLLAMA_API_KEY=dummy

# Optional C2Rust/LLVM overrides for local installations
SAFEMAP_C2RUST_CLANG=/opt/llvm-14.0.6/bin/clang
SAFEMAP_C2RUST_RESOURCE_DIR=/opt/llvm-14.0.6/lib/clang/14.0.6
SAFEMAP_C2RUST_LIB_DIR=/opt/llvm-14.0.6/lib

# Groq (OpenAI-compatible)
GROQ_API_KEY=replace_with_your_groq_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (OpenAI-compatible), free models only
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
